# Copy this file to ".env" and fill in your key. The ".env" file is ignored by git.
# Never put a real key in this example file.
DEEPSEEK_API_KEY=your-key-here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=30
# Reasoning mode: "off" is faster, cheaper and recommended for this project.
DEEPSEEK_THINKING=off
